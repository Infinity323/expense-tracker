{
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.835.0",
    "@aws-sdk/credential-providers": "^3.835.0",
    "@aws-sdk/lib-dynamodb": "^3.835.0",
    "@codegenie/serverless-express": "^4.16.0",
    "@types/express": "^5.0.3",
    "@types/plaid-link": "^2.0.15",
    "@types/react-plaid-link": "^2.0.0",
    "aws-jwt-verify": "^5.1.0",
    "cors": "^2.8.5",
    "csv": "^6.3.10",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "mkdirp": "^3.0.1",
    "plaid": "^35.0.0",
    "swagger-jsdoc": "^6.2.8"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.7",
    "@swc/core": "^1.12.6",
    "@swc/plugin-transform-imports": "^8.0.3",
    "@types/aws-lambda": "^8.10.160",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.5",
    "tsx": "^4.19.4"
  },
  "scripts": {
    "start": "tsx index.ts",
    "clean": "(rm -r dist || true) && (rm server.zip || true)",
    "build": "npm run clean && npx swc . -d dist",
    "build:ci": "tsc && npm run build && npx esbuild dist/lambda.js --bundle --platform=node --outfile=dist/index.cjs",
    "package": "npm run build:ci && cd dist && zip ../server.zip index.cjs"
  },
  "type": "module"
}
